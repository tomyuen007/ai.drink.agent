{
  // VS Code debug configurations for Weather AI (Expo SDK 56 / RN 0.85 / Hermes)
  //
  // Prerequisites — install these VS Code extensions:
  //   expo.vscode-expo-tools       (Expo Tools)
  //   msjsdiag.vscode-react-native (React Native Tools)
  //   ms-vscode.js-debug-nightly   (Better web source maps — recommended)
  //
  // Open VS Code at the ui/ folder:
  //   code /path/to/wine.liquor/ui
  //
  // One-click start:
  //   Ctrl+Shift+D → "Debug: Weather UI (Web)" → F5
  //   Metro starts automatically, Chrome opens when ready.
  //   Ctrl+Shift+F5 stops everything.
  //
  // Manual configs — Metro must already be running (npx expo start --web):
  //   "Debug: Web — Launch Chrome"   opens a new Chrome window
  //   "Debug: Web — Attach Chrome"   attaches to existing Chrome on port 9222
  //   "Debug: iOS — Hermes"          attaches to iOS Simulator (run debug-ios.sh first)
  //   "Debug: Android — Hermes"      attaches to Android Emulator (run debug-android.sh first)

  "version": "0.2.0",

  "compounds": [
    {
      "name": "Debug: Weather UI (Web)",
      "configurations": ["Debug: Web — Launch Chrome"],
      "stopAll": true,
      "preLaunchTask": "Start Expo Web"
    }
  ],

  "configurations": [

    // ── Web ──────────────────────────────────────────────────────────────────

    {
      "name": "Debug: Web — Launch Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*":   "${workspaceFolder}/*",
        "webpack:///./~/*": "${workspaceFolder}/node_modules/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },

    {
      // Attaches to an existing Chrome started with --remote-debugging-port=9222.
      // Use this to keep your Chrome session alive between debug restarts.
      "name": "Debug: Web — Attach Chrome",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:8081/*",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },

    // ── iOS ──────────────────────────────────────────────────────────────────

    {
      // Attaches the Hermes/CDP debugger to the iOS Simulator.
      // Run debug-ios.sh first and wait for the app to load.
      // If connection fails: Cmd+Ctrl+Z in simulator → "Open JS Debugger".
      "name": "Debug: iOS — Hermes",
      "type": "reactnativedirect",
      "request": "launch",
      "platform": "ios",
      "target": "simulator",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "metro://ProjectRoot/*": "${workspaceFolder}/*",
        "/__metro_bundle_path__*": "${workspaceFolder}/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },

    // ── Android ──────────────────────────────────────────────────────────────

    {
      // Attaches the Hermes/CDP debugger to the Android Emulator via ADB.
      // Run debug-android.sh first and wait for the app to load.
      // If connection fails: Ctrl+M in emulator → "Open JS Debugger".
      "name": "Debug: Android — Hermes",
      "type": "reactnativedirect",
      "request": "launch",
      "platform": "android",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "metro://ProjectRoot/*": "${workspaceFolder}/*",
        "/__metro_bundle_path__*": "${workspaceFolder}/*"
      },
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    },

    // ── Attach (any running app) ──────────────────────────────────────────────

    {
      // Attaches to any already-running React Native app (iOS or Android)
      // in dev/debug mode. Use when the app is open and you want to attach
      // without relaunching the simulator or emulator.
      "name": "Debug: Attach to Running App",
      "type": "reactnativedirect",
      "request": "attach",
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**"
      ]
    }

  ]
}
