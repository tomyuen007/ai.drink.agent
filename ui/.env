# ── Agent ────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_AGENT_URL=http://localhost:8001

# ── Questions ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_QUESTIONS_LIMIT=10

# ── Running mode ─────────────────────────────────────────────────────────────
# ONLINE=1  live API calls (default)
# ONLINE=0  offline — input only from .env, no external calls
EXPO_PUBLIC_ONLINE=0

# ── State sync ───────────────────────────────────────────────────────────────
# STATE_SYNC=1  seed Redux store from EXPO_PUBLIC_APP_STATES on each launch (default)
# STATE_SYNC=0  preserve persisted AsyncStorage state; ignore APP_STATES
EXPO_PUBLIC_STATE_SYNC=0

# ── History logging ─────────────────────────────────────────────────────────
# HISTORY_LOG=1  save activity history to SQLite/OPFS (one browser tab only)
# HISTORY_LOG=0  log history to console only (default; no OPFS file contention)
EXPO_PUBLIC_HISTORY_LOG=0

# ── App states (applied when STATE_SYNC=1) ────────────────────────────────────
# Single JSON object covering all slices.  Same shape accepted by SyncStatesModal.
EXPO_PUBLIC_APP_STATES={"user":{"email":"demo@example.com","phone":""},"settings":{"online":true,"stateSync":true,"llmProvider":"env-default","theme":"system","notifications":true,"defaultCity":"Toronto","defaultPage":"home","fontFamily":"system","fontSize":"medium","fontWeight":"regular","fontStyle":"normal","historyLog":0},"weather":{"city":"Toronto","question":"Should I bring an umbrella?"},"questions":{"items":["Should I bring an umbrella?","What is the temperature today?","Will it rain this weekend?","Is it safe to go for a run outside?","Should I wear a jacket?"]}}
