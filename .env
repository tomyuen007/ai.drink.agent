# ── Docker Compose profile selection ─────────────────────────────────────────
# Comma-separated list of services to start with: docker compose up -d
# Options: localstack, mssql, oracle, mysql, postgresql, firebase, duckdb, all
COMPOSE_PROFILES=postgresql

# ── MSSQL ─────────────────────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=WineL1quor#2024

# ── Oracle ────────────────────────────────────────────────────────────────────
ORACLE_PASSWORD=WineL1quor#2024

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=WineL1quor#2024
MYSQL_USER=wineuser
MYSQL_PASSWORD=WineUser#2024

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=WineL1quor#2024

# ── App DB users (applied to all databases) ───────────────────────────────────
APP_USER_ADMIN=app_user_admin
APP_USER_ADMIN_PASSWORD=123456
APP_USER_RW=app_user_rw
APP_USER_RW_PASSWORD=123456

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=demo-wine-liquor

# ── LocalStack ────────────────────────────────────────────────────────────────
LOCALSTACK_SERVICES=s3,sqs,sns,dynamodb,secretsmanager,lambda

# ── UI behaviour ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_AGENT_URL=http://localhost:8001
EXPO_PUBLIC_QUESTIONS_LIMIT=10

# ── App ports ─────────────────────────────────────────────────────────────────
DUCKDB_PORT=8000
AGENT_PORT=8001
UI_PORT=3000
OLLAMA_PORT=11434

# ── LLM provider ──────────────────────────────────────────────────────────────
# Used by lib/llm_client.py and ai.agents/weather/agent.py.
# Switch the active provider by changing LLM_PROVIDER.
#
# Valid values:
#   claude        Anthropic Claude API
#   ollama        Ollama local server
#   openai        OpenAI API
#   gemini        Google Gemini API
#   groq          Groq API
#   bedrock       AWS Bedrock
#   openai-compat Any OpenAI-compatible endpoint (LM Studio, vLLM, Together AI, Azure…)

LLM_PROVIDER=claude

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is used ONLY when LLM_PROVIDER=claude.
# Do not use this key for any other provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza-replace-me
GEMINI_MODEL=gemini-2.0-flash

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_replace-me
GROQ_MODEL=llama-3.3-70b-versatile

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY,
# a named profile (~/.aws/credentials), or an IAM instance role.
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── OpenAI-compatible (LM Studio, vLLM, Together AI, Azure OpenAI…) ──────────
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
OPENAI_COMPAT_API_KEY=lm-studio
OPENAI_COMPAT_MODEL=local-model
