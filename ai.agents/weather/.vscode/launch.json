{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Weather Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agent.py",
      "python": "${workspaceFolder}/venv/bin/python",
      "cwd": "${workspaceFolder}/../..",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../..:${workspaceFolder}/../../rags/weather"
      },
      "envFile": "${workspaceFolder}/../../.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
