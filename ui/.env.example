# Copy to ui/.env for local development.
# EXPO_PUBLIC_ prefix bakes the value into the JS bundle at build time (expo export).

# ── Agent ────────────────────────────────────────────────────────────────────
# Local dev — default fallback used if this file is absent
EXPO_PUBLIC_AGENT_URL=http://localhost:8001

# Android emulator (host machine is 10.0.2.2 from inside the emulator)
# EXPO_PUBLIC_AGENT_URL=http://10.0.2.2:8001

# Physical device (replace with your machine's LAN IP)
# EXPO_PUBLIC_AGENT_URL=http://192.168.1.x:8001

# Lambda deployment — set via TF_VAR_agent_url; Terraform injects it during expo export
# EXPO_PUBLIC_AGENT_URL=https://xxxx.lambda-url.us-east-1.on.aws/

# ── Questions ────────────────────────────────────────────────────────────────
# Max questions stored for the Quick Questions dropdown (default: 10)
EXPO_PUBLIC_QUESTIONS_LIMIT=10

# ── Running mode ─────────────────────────────────────────────────────────────
# ONLINE=1  make real API calls to fetch weather data (default)
# ONLINE=0  offline mode — input only from .env; no external calls
EXPO_PUBLIC_ONLINE=1

# ── State sync ───────────────────────────────────────────────────────────────
# STATE_SYNC=1  seed the store from EXPO_PUBLIC_APP_STATES on each launch (default)
# STATE_SYNC=0  preserve persisted AsyncStorage state; APP_STATES is ignored
EXPO_PUBLIC_STATE_SYNC=0

# ── App states (applied when STATE_SYNC=1) ────────────────────────────────────
# Single JSON object covering all slices.  Same shape accepted by SyncStatesModal.
# Keys: user | settings | weather | questions  (all optional)
EXPO_PUBLIC_APP_STATES={"user":{"email":"demo@example.com","phone":""},"settings":{"online":true,"stateSync":true,"theme":"system","notifications":true,"defaultCity":"Toronto","defaultPage":"home"},"weather":{"city":"Toronto","question":"Should I bring an umbrella?"},"questions":{"items":["Should I bring an umbrella?","What is the temperature today?","Will it rain this weekend?","Is it safe to go for a run outside?","Should I wear a jacket?"]}}
