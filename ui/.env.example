# Copy to ui/.env for local development.
# EXPO_PUBLIC_ prefix bakes the value into the JS bundle at build time (expo export).

# Local dev — default fallback used if this file is absent
EXPO_PUBLIC_AGENT_URL=http://localhost:8001

# Android emulator (host machine is 10.0.2.2 from inside the emulator)
# EXPO_PUBLIC_AGENT_URL=http://10.0.2.2:8001

# Physical device (replace with your machine's LAN IP)
# EXPO_PUBLIC_AGENT_URL=http://192.168.1.x:8001

# Lambda deployment — set via TF_VAR_agent_url; Terraform injects it during expo export
# EXPO_PUBLIC_AGENT_URL=https://xxxx.lambda-url.us-east-1.on.aws/
